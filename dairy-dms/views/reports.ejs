<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Dairy Inventory - Reports</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/dashboard">Dairy Inventory</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href="/dashboard">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/farmers">Farmers</a></li>
          <li class="nav-item"><a class="nav-link" href="/milk">Milk Collection</a></li>
          <li class="nav-item"><a class="nav-link" href="/payments">Payments</a></li>
          <li class="nav-item"><a class="nav-link active" href="/reports">Reports</a></li>
        </ul>
        <span class="navbar-text me-3 text-white">
          <%= user ? user.full_name : "" %>
        </span>
        <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <h3 class="mb-3">Daily Collection Report</h3>

    <% if (error) { %>
      <div class="alert alert-danger py-2"><%= error %></div>
    <% } %>

    <!-- Input Form -->
    <div class="card shadow-sm mb-4">
      <div class="card-header">
        <strong>Generate Daily Report</strong>
      </div>
      <div class="card-body">
        <form action="/reports" method="POST" class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Farmer Name *</label>
            <input type="text" name="name" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Village *</label>
            <input type="text" name="village" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Date *</label>
            <input type="date" name="date" class="form-control" required>
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-primary">Generate Report</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Report Result -->
    <% if (daily) { %>
      <div class="card shadow-sm">
        <div class="card-header">
          <strong>Report Result</strong>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <p class="mb-1"><strong>Farmer:</strong> <%= daily.farmerName %></p>
            <p class="mb-1"><strong>Village:</strong> <%= daily.village %></p>
            <p class="mb-1"><strong>Date:</strong> <%= daily.date %></p>
          </div>

          <div class="table-responsive mb-3">
            <table class="table table-striped table-sm align-middle">
              <thead class="table-light">
                <tr>
                  <th>Date</th>
                  <th>Milk Type</th>
                  <th>Total Liters</th>
                  <th>Rate per Liter (₹)</th>
                  <th>Amount (₹)</th>
                </tr>
              </thead>
              <tbody>
                <% daily.rows.forEach(function(row) { %>
                  <tr>
                    <td><%= row.collection_date %></td>
                    <td><%= row.milk_type %></td>
                    <td><%= row.total_liters %></td>
                    <td><%= row.rate_per_liter %></td>
                    <td><%= row.amount %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div class="alert alert-info">
            <strong>Total Liters Collected:</strong> <%= daily.totalLiters %> L
            &nbsp; | &nbsp;
            <strong>Total Amount:</strong>
            ₹ <%= Number(daily.totalAmount || 0).toFixed(2) %>
          </div>
        </div>
      </div>
    <% } %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
