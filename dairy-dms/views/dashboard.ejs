<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Dairy Inventory - Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .hero-section {
      height: 320px;
      background-image: url("/images/dairy-hero.svg"); /* put your generated image here */
      background-size: cover;
      background-position: center;
      border-radius: 12px;
      position: relative;
      overflow: hidden;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
    }
    .hero-content {
      position: relative;
      z-index: 2;
      color: #fff;
      padding: 2rem;
    }
  </style>
</head>
<body class="bg-light">

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/dashboard">Dairy Inventory</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link active" href="/dashboard">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/farmers">Farmers</a></li>
          <li class="nav-item"><a class="nav-link" href="/milk">Milk Collection</a></li>
          <li class="nav-item"><a class="nav-link" href="/payments">Payments</a></li>
          <li class="nav-item"><a class="nav-link" href="/reports">Reports</a></li>
        </ul>
        <span class="navbar-text me-3 text-white">
          <%= user ? user.full_name : "" %>
        </span>
        <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <div class="container my-4">
    <!-- HERO IMAGE SECTION -->
    <div class="hero-section mb-4">
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1 class="display-6 fw-bold">Welcome, <%= user.full_name %></h1>
        <p class="lead mb-3">Track your dairy inventory, milk collection, farmers and payments in one place.</p>
        <a href="/milk" class="btn btn-light btn-sm me-2">Add Milk Entry</a>
        <a href="/farmers" class="btn btn-outline-light btn-sm">View Farmers</a>
      </div>
    </div>

    <!-- DASHBOARD CARDS -->
    <div class="row g-3">
      <!-- Total Farmers -->
      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h6 class="card-title text-muted text-uppercase">Total Farmers</h6>
            <h3 class="fw-bold">
              <%= typeof totalFarmers !== 'undefined' ? totalFarmers : '--' %>
            </h3>
            <p class="mb-0 small text-muted">Total farmers registered in the system.</p>
          </div>
        </div>
      </div>

      <!-- Milk Available (All Time) -->
      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h6 class="card-title text-muted text-uppercase">Milk Available</h6>
            <h3 class="fw-bold">
              <% if (typeof milkAvailable !== 'undefined') { %>
                <%= Number(milkAvailable).toFixed(2) %> L
              <% } else { %>
                -- L
              <% } %>
            </h3>
            <p class="mb-0 small text-muted">
              Total milk collected in the dairy so far.
            </p>
          </div>
        </div>
      </div>

      <!-- You can add more cards here later -->
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
